# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never exposed to the browser.
# Used for trusted backend writes (e.g. ingestion job updates from background workers).
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — leave blank to use the stub analyzer.
GEMINI_API_KEY=

# Cobalt — Instagram downloads (self-hosted). Leave blank to use the stub.
COBALT_API_URL=
COBALT_API_KEY=

# Apify — TikTok downloads (Cobalt is blocked at TikTok's datacenter-IP filter).
# Leave APIFY_API_TOKEN blank to fall back to the stub for TikTok URLs.
# APIFY_TIKTOK_ACTOR is optional; defaults to clockworks/tiktok-scraper.
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR=

# Upstash Redis — per-user rate limiting. Leave blank in dev (limit becomes a no-op).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics page (Phase 3) ──
# While ANALYTICS_MOCK_MODE is unset or "true", the /analytics page uses
# stub providers that generate synthetic posts + metrics. Flip to "false"
# only after wiring real OAuth + Insights pulls.
ANALYTICS_MOCK_MODE=true

# Meta (Instagram Graph API) — required for real Instagram analytics.
# Currently unused; provider is a skeleton.
META_APP_ID=
META_APP_SECRET=

# TikTok Display API — required for real TikTok analytics.
# Currently unused; provider is a skeleton.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
