# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never exposed to the browser.
# Used for trusted backend writes (e.g. ingestion job updates from background workers).
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — Phase 2. Leave blank for Phase 1 stub provider.
GEMINI_API_KEY=

# Cobalt — Phase 2. Leave blank for Phase 1 stub provider.
COBALT_API_URL=
