# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never exposed to the browser.
# Used for trusted backend writes (e.g. ingestion job updates from background workers).
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — leave blank to use the stub analyzer.
GEMINI_API_KEY=

# Cobalt — legacy Instagram downloader (self-hosted). Deprecated: IG now routes
# through Apify whenever APIFY_API_TOKEN is set. Cobalt is only used for IG when
# no Apify token is present. Safe to remove once Apify IG parity is confirmed.
COBALT_API_URL=
COBALT_API_KEY=

# Apify — TikTok + Instagram downloads. One token drives both platforms.
# Leave APIFY_API_TOKEN blank to fall back to the stubs.
# Actor overrides are optional; defaults shown in comments.
# APIFY_TIKTOK_ACTOR         defaults to clockworks/tiktok-scraper
# APIFY_INSTAGRAM_REEL_ACTOR defaults to apify/instagram-reel-scraper (primary)
# APIFY_INSTAGRAM_POST_ACTOR defaults to apify/instagram-post-scraper (fallback)
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR=
APIFY_INSTAGRAM_REEL_ACTOR=
APIFY_INSTAGRAM_POST_ACTOR=

# Upstash Redis — per-user rate limiting. Leave blank in dev (limit becomes a no-op).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Analytics page (Phase 3) ──
# ANALYTICS_MOCK_MODE controls TikTok only (IG flips to real automatically
# once META_APP_ID + META_APP_SECRET are present). Leave it "true" until
# TikTok Display API credentials are wired.
ANALYTICS_MOCK_MODE=true

# Instagram OAuth — Instagram API with Instagram Login.
# Setup walkthrough: docs/instagram-oauth-setup.md
#   1. Create a Meta app at developers.facebook.com (type: Business)
#   2. Add the Instagram product → Instagram API setup with Instagram Login
#   3. Register OAuth redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/instagram/callback
#      e.g. https://inspo-me.vercel.app/api/auth/instagram/callback
#   4. Add yourself as a test user in App Roles → Roles
#   5. Set Instagram account to Creator or Business in the IG app
META_APP_ID=
META_APP_SECRET=

# Public origin of the app (used to build OAuth redirect URIs).
# Leave blank to fall back to VERCEL_PROJECT_PRODUCTION_URL or localhost.
NEXT_PUBLIC_APP_URL=

# Symmetric key used to encrypt OAuth tokens at rest (AES-GCM).
# Required in production. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# TikTok Display API — required for real TikTok analytics.
# Currently unused; provider is a skeleton.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
