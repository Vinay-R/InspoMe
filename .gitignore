# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + workspaces)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (any workspace)
.next/
out/

# production
build/

# expo (any workspace)
.expo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase cli cache
/supabase/.temp/
/supabase/.branches/

# worklogs are local-only — they're for context restoration, not artifacts
/worklogs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local notes — never commit
/Notes_Prompts/
